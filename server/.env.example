# MongoDB Connection URI
MONGO_URI=mongodb://localhost:27017/smartresto

# JSON Web Token Secret (generate a strong 256-bit key in production, e.g. openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_secret_in_production

# Backend Server Port
PORT=5000

# Frontend URL (for CORS and table QR code generation in production)
FRONTEND_URL=http://localhost:5173

# Google Gemini Generative AI API Key (required for Chef Akxi culinary assistant)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
